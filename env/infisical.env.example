# truefisical environment file — copy this to `.env` at the repo root.
#
#   cp env/infisical.env.example .env
#   chmod 600 .env
#
# Then edit `.env` and fill in the REQUIRED block before starting the stack.
# The full Infisical env var reference is at:
#   https://infisical.com/docs/self-hosting/configuration/envars

# =============================================================================
# REQUIRED — must be set before first boot
# =============================================================================

# Platform encryption key for secret ops. Generate a fresh 32-byte hex string:
#   openssl rand -hex 16
# Losing this key permanently decrypts nothing: back it up offline (password
# manager + printed copy) before storing any secrets.
ENCRYPTION_KEY=replace-me-openssl-rand-hex-16

# JWT signing secret. Generate a fresh 32-byte base64 string:
#   openssl rand -base64 32
# Losing this logs everyone out but does not lose data. Still, back it up.
AUTH_SECRET=replace-me-openssl-rand-base64-32

# Postgres credentials used by both the `db` container and the backend.
# The backend's DB_CONNECTION_URI is composed from these.
POSTGRES_USER=infisical
POSTGRES_PASSWORD=replace-me-strong-random-password
POSTGRES_DB=infisical

# Postgres connection string used by the backend. The defaults reference the
# container hostname `db` defined in compose/docker-compose.yml.
DB_CONNECTION_URI=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis connection string. Default matches the `redis` container in compose.
REDIS_URL=redis://redis:6379

# Public URL users will reach the UI at. For local workstation dev this is
# http://localhost:<host-port> matching TRUEFISICAL_HOST_PORT below. For a
# real install, set this to the exact URL (scheme + host + port) users type.
SITE_URL=http://localhost:8080

# =============================================================================
# OPTIONAL — truefisical / compose tuning
# =============================================================================

# Host port the UI binds to on the Docker host. 8080 by default so we don't
# clash with other services on 80.
TRUEFISICAL_HOST_PORT=8080

# =============================================================================
# OPTIONAL — SMTP (needed for password reset, invites, notifications)
# Leave blank to disable email features.
# =============================================================================

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# =============================================================================
# OPTIONAL — Infisical Enterprise license
# Only set if you have purchased an Infisical Pro or Enterprise subscription.
# Without this, the stack runs with Free-tier features only. See:
#   https://infisical.com/docs/self-hosting/ee
# =============================================================================

LICENSE_KEY=

# =============================================================================
# OPTIONAL — SSO (Infisical OAuth apps for Google/GitHub/GitLab login)
# Leave blank unless you've registered OAuth apps with those providers.
# =============================================================================

CLIENT_ID_GOOGLE_LOGIN=
CLIENT_SECRET_GOOGLE_LOGIN=
CLIENT_ID_GITHUB_LOGIN=
CLIENT_SECRET_GITHUB_LOGIN=
CLIENT_ID_GITLAB_LOGIN=
CLIENT_SECRET_GITLAB_LOGIN=

# =============================================================================
# OPTIONAL — Observability
# =============================================================================

SENTRY_DSN=
OTEL_TELEMETRY_COLLECTION_ENABLED=false
OTEL_EXPORT_TYPE=prometheus
OTEL_EXPORT_OTLP_ENDPOINT=
OTEL_OTLP_PUSH_INTERVAL=
OTEL_COLLECTOR_BASIC_AUTH_USERNAME=
OTEL_COLLECTOR_BASIC_AUTH_PASSWORD=

# =============================================================================
# OPTIONAL — Captcha (defensive rate limiting on sign-up)
# =============================================================================

CAPTCHA_SECRET=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# =============================================================================
# The full upstream env var list (integrations, app connections, Datadog,
# ClickHouse audit-log storage, etc.) is intentionally omitted here to keep
# this file scannable. Anything set in `.env` is passed through to the
# backend container; see the Infisical docs linked at the top of this file
# for the full reference.
# =============================================================================
